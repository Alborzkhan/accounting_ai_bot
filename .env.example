# ===== نارین - حسابدار هوشمند =====
# متغیرهای محیطی مورد نیاز برای اجرای پروژه
# Copy this file to .env and fill in your values

# === تلگرام ===
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_NAME=Hesabdarbazarbot

# === بله ===
BALE_TOKEN=your_bale_bot_token
BALE_BOT_NAME=hesabdarkuchakbot

# === هوش مصنوعی ===
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# === پرداخت زرین‌پال ===
ZARINPAL_MERCHANT_ID=your_merchant_id
ZARINPAL_CALLBACK_URL=http://localhost:8000/payment/callback

# === پیامک ===
FARAPAYAMAK_USERNAME=
FARAPAYAMAK_PASSWORD=
FARAPAYAMAK_SENDER=

# === دیتابیس ===
# SQLite: کامنت کنید. PostgreSQL: DATABASE_URL=postgresql://user:pass@host:5432/db
DATABASE_URL=

# === امنیت ===
JWT_SECRET_KEY=change_this_to_random_string
JWT_EXPIRY_HOURS=168
ALLOWED_ORIGINS=http://localhost:8000
PUBLIC_APP_URL=http://localhost:8000
ADMIN_PHONE=09120000000
